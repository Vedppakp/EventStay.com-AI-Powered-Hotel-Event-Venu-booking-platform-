# EventStay Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB Atlas in Production / Local in Dev)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eventstay?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_production_jwt_secret_here

# Frontend Application Origin (for Production CORS)
FRONTEND_URL=https://your-netlify-site.netlify.app

# Optional: Google Gemini AI API Key (for AI Concierge & Package Recommendation)
GEMINI_API_KEY=your_gemini_api_key

# Optional: SMTP Email Configuration (for OTP delivery & password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username@gmail.com
SMTP_PASS=your_smtp_app_password
